#!/bin/bash
# Verification script that runs before merge in finish-bead
# Returns 0 if verification passes, non-zero if it fails

# Allow skipping verification with SKIP_VERIFICATION=1
if [ "$SKIP_VERIFICATION" = "1" ]; then
    echo "=== Verification skipped (SKIP_VERIFICATION=1) ==="
    exit 0
fi

set -e

TASK_NAME="$1"
WORKTREE_PATH="/sandbox/.worktrees/$TASK_NAME"

echo "=== Verification before merge ==="
echo "Task: $TASK_NAME"
echo "Worktree: $WORKTREE_PATH"

# Check 1: Is Llama Monitor running on Windows?
# We check by looking for the process and the lock file
echo ""
echo "Check 1: Llama Monitor running on Windows..."

# The Llama Monitor web server and its aggregator daemon API listen on their own
# ports (the web server defaults to 8080, the aggregator daemon API to 8081),
# NOT on llama.cpp's port 8000. 8000 is llama-server's own /metrics endpoint.
#
# A single monitor may be reachable at more than one host/port (e.g. the copy
# running inside this docker container on 8080 AND a copy on the Windows host on
# 8081). LLAMA_MONITOR_URLS accepts a space-separated list of monitor base URLs
# to probe; if ANY of them is reachable and actively running, the merge is
# aborted. Defaults to checking both the local docker container (localhost:8080)
# and the Windows host (host.docker.internal:8081), so a running monitor is
# caught wherever it lives.
#
# The aggregator daemon API (/api/status) is the monitor's live data endpoint.
MONITOR_URLS="${LLAMA_MONITOR_URLS:-http://localhost:8080 http://host.docker.internal:8081}"

if command -v curl >/dev/null 2>&1; then
    MONITOR_FOUND=""
    for MONITOR_URL in ${MONITOR_URLS}; do
        # Try to connect to the Llama Monitor using its /api/status health
        # endpoint. A successful JSON response with a "status" field means the
        # monitor (or its aggregator daemon) is reachable at this URL.
        MONITOR_RESPONSE=$(curl -s --connect-timeout 2 "${MONITOR_URL}/api/status" 2>/dev/null) || MONITOR_RESPONSE=""
        if [ -n "$MONITOR_RESPONSE" ] && echo "$MONITOR_RESPONSE" | grep -q '"status"'; then
            echo "  WARNING: Llama Monitor appears to be running at ${MONITOR_URL}!"
            echo "  The database may be corrupted if we proceed with the merge."
            MONITOR_FOUND=1

            # Check whether the monitor reports itself as actively running.
            # If the aggregator reports a non-running/stopped status, it is safe
            # to proceed; otherwise abort to avoid corrupting a live database.
            if echo "$MONITOR_RESPONSE" | grep -q '"status"[[:space:]]*:[[:space:]]*"running"'; then
                echo "  ERROR: Llama Monitor is actively running at ${MONITOR_URL}. Aborting merge."
                echo "  Please stop Llama Monitor before merging,"
                echo "  or set LLAMA_MONITOR_URLS to the correct monitor endpoints."
                exit 1
            else
                echo "  Monitor at ${MONITOR_URL} is reachable but not actively running - safe to proceed"
            fi
        fi
    done
    if [ -z "$MONITOR_FOUND" ]; then
        echo "  OK: Llama Monitor is not reachable at any of: ${MONITOR_URLS}"
    fi
else
    echo "  WARNING: curl not available, cannot check Llama Monitor status"
fi

# Check 2: Run unit tests in Docker
echo ""
echo "Check 2: Running verification tests..."

if [ -f "$WORKTREE_PATH/test_llama-monitor.py" ]; then
    echo "  Found test file, running tests..."
    cd "$WORKTREE_PATH"
    python3 test_llama-monitor.py 2>&1 || {
        echo "  ERROR: Tests failed"
        exit 1
    }
    echo "  OK: Tests passed"
else
    echo "  No test file found, skipping tests"
fi

# Check 3: Syntax check Python files
echo ""
echo "Check 3: Syntax check..."
cd "$WORKTREE_PATH"
for file in $(find . -name "*.py" -not -path "./.git/*" -not -path "./node_modules/*"); do
    python3 -m py_compile "$file" 2>&1 || {
        echo "  ERROR: Syntax error in $file"
        exit 1
    }
done
echo "  OK: All Python files have valid syntax"

echo ""
echo "=== All verification checks passed ==="
exit 0
